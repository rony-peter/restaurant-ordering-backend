generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TableStatus {
  FREE
  OCCUPIED
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY
  SERVED
  PAID
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  PAY_AT_TABLE
  ONLINE
}

enum StaffRole {
  MANAGER
  COOK
  ADMIN
}

model Restaurant {
  id       String    @id @default(uuid())
  name     String
  settings Json?     // e.g., { "address": "123 Main St", "taxRate": 0.05, "currency": "INR", "phone": "+91..." }

  tables    Table[]
  menuItems MenuItem[]
  orders    Order[]
  staff     Staff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("restaurants")
}

model Table {
  id           String      @id @default(uuid())
  restaurantId String
  tableNumber  String
  qrCodeToken  String      @unique
  status       TableStatus @default(FREE)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, tableNumber])
  @@index([restaurantId])
  @@map("tables")
}

model MenuItem {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  price        Decimal  @db.Decimal(10, 2)
  category     String
  description  String?
  imageUrl     String?
  isAvailable  Boolean  @default(true)
  dietaryTags  String[]

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([restaurantId, isAvailable])
  @@map("menu_items")
}

model Order {
  id           String      @id @default(uuid())
  tableId      String
  restaurantId String
  notes        String?
  status       OrderStatus @default(PLACED)

  table      Table       @relation(fields: [tableId], references: [id], onDelete: Cascade)
  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      OrderItem[]
  payments   Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tableId])
  @@index([restaurantId])
  @@index([tableId, status])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  menuItemId String
  quantity   Int
  notes      String?

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

model Payment {
  id         String        @id @default(uuid())
  orderId    String
  amount     Decimal       @db.Decimal(10, 2)
  method     PaymentMethod @default(PAY_AT_TABLE)
  status     PaymentStatus @default(PENDING)
  gatewayRef String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model Staff {
  id           String    @id @default(uuid())
  restaurantId String
  email        String
  passwordHash String
  role         StaffRole

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, email])
  @@index([restaurantId])
  @@map("staff")
}